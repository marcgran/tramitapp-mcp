# Copia este archivo a .env y rellena tus valores.
# El archivo .env nunca debe subirse a GitHub (ya está en .gitignore).

# URL base de la API de TramitApp
TRAMITAPP_BASE_URL=https://rrhh.tramitapp.com

# Token de tu cuenta (demo o producción)
TRAMITAPP_API_TOKEN=PEGA_AQUI_TU_TOKEN

# Modo de autenticación:
#   header  → <TRAMITAPP_AUTH_HEADER>: <token>   (correcto para TramitApp)
#   bearer  → Authorization: Bearer <token>
TRAMITAPP_AUTH_MODE=header
TRAMITAPP_AUTH_HEADER=auth

# Timeout en segundos para las llamadas a la API
TRAMITAPP_TIMEOUT=30

# Empresa por defecto (OPCIONAL) — nombre o _id de la sociedad.
# Cada tool acepta un parámetro `empresa` que la sobreescribe (multiempresa);
# si se deja vacío y el token accede a varias sociedades, habrá que indicar
# `empresa` en cada llamada. Lista las disponibles con la tool listar_empresas.
TRAMITAPP_EMPRESA_ID=
